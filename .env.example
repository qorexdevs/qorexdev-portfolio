# Production Compose. Never put secrets in VITE_* variables.
DOMAIN=portfolio.example.com
WWW_DOMAIN=www.portfolio.example.com
PUBLIC_ORIGIN=https://portfolio.example.com
ACME_EMAIL=webmaster@example.com

# Optional: verify Telegram initData and answer the bot's webhook.
# Keep both values on the server. Register the HTTPS Mini App URL and webhook via Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Bounded public demo limits. Per IP: API requests/minute, new sessions/hour.
MAX_WORKSPACES=200
RATE_LIMIT_MAX=120
NEW_WORKSPACE_LIMIT=20

# Local Node development only; Compose sets its own DB_PATH and TRUST_PROXY.
PORT=3000
DB_PATH=./data/demo.sqlite
TRUST_PROXY=0
